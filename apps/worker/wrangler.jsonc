{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "camarada-ho-chi-miau",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "minify": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*"],
  },
  "vars": {
    "APP_ENV": "development",
    "PHOTO_MAX_BYTES": "5242880",
    "TELEGRAM_BOT_USERNAME": "camarada_ho_chi_miau_bot",
    "PANEL_URL": "https://camarada-ho-chi-miau.gibapacce.workers.dev",
  },
  // Cota gratuita: 10.000 Neurons/dia; acima disso a IA falha e o assistente cai nas regras.
  "ai": {
    "binding": "AI",
  },
  // Plano gratuito: sem limits/usage_model pagos. Nada de R2, Queues ou Durable Objects por enquanto.
  "observability": {
    "enabled": true,
  },
  // Lembretes a cada 5 minutos; limpeza diária às 06:00 UTC (CLEANUP_CRON em src/index.ts).
  // O plano gratuito permite 5 Cron Triggers por conta.
  "triggers": {
    "crons": ["*/5 * * * *", "0 6 * * *"],
  },
}
