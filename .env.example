# Modelo de variáveis. NUNCA coloque valores reais aqui.
# Desenvolvimento local do Worker: copie para apps/worker/.dev.vars (ignorado pelo Git).
# Produção: use `npx wrangler secret put NOME` (fica no cofre da Cloudflare).
# Variáveis não secretas ficam em apps/worker/wrangler.jsonc ("vars").

# Fase 2: Supabase (somente no servidor; nunca no painel)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fase 3: chave pública usada pelo painel para login (pode ir ao navegador)
SUPABASE_ANON_KEY=

# Fase 7: Telegram (token do @BotFather e segredo aleatório do webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Fase 5 (opcional): fallback de IA. Workers AI usa binding, sem chave.
GEMINI_API_KEY=
